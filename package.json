{
  "name": "bce-construction-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8000 --host",
    "deploy": "npm run content:export && npm run build && npm run db:migrate && npm run worker:deploy && wrangler pages deploy dist --project-name bce-construction --branch=main --commit-dirty=true",
    "deploy:staging": "npm run content:export && npm run build && npm run worker:deploy:staging && wrangler pages deploy dist --project-name bce-construction --branch=staging --commit-dirty=true",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "worker:dev": "wrangler dev --port 8787 --local --var READ_ONLY:false",
    "worker:dev:production": "wrangler dev --env production --port 8787 --local --var READ_ONLY:false",
    "worker:deploy": "wrangler deploy --env production",
    "worker:deploy:staging": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply bce-content --remote --env production",
    "db:migrate:local": "wrangler d1 migrations apply bce-content --local",
    "content:export": "node scripts/export-content.mjs",
    "content:seed": "node scripts/export-content.mjs && wrangler d1 execute bce-content --remote --file=seed/seed.sql",
    "content:seed:local": "node scripts/export-content.mjs && wrangler d1 execute bce-content --local --file=seed/seed.sql"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.6",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.72.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.92.0",
    "react-resizable-panels": "^4.22.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "wrangler": "^4.161.0"
  }
}
